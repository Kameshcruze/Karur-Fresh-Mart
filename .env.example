# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Frontend REST API Client Configuration (src/services/api.ts)
# ---------------------------------------------------------------------------
# Base URL for the Node.js + PostgreSQL REST backend.
VITE_API_BASE_URL="http://localhost:4000/api"

# Toggle between client-side mock data + localStorage ("true") and live REST API ("false").
VITE_USE_MOCK="true"

# Public Razorpay Key ID used by window.Razorpay Checkout on the client (safe to expose).
VITE_RAZORPAY_KEY_ID="rzp_test_replace_with_key"

# ---------------------------------------------------------------------------
# Backend Reference Variables (Node.js + PostgreSQL Server Only — NEVER prefix with VITE_)
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:password@localhost:5432/karur_fresh_mart"
# JWT_SECRET="replace_with_strong_random_secret"
#
# WhatsApp OTP (Meta Cloud API Authentication Template):
# WHATSAPP_CLOUD_API_VERSION="v21.0"
# WHATSAPP_PHONE_NUMBER_ID="replace_with_meta_phone_number_id"
# WHATSAPP_CLOUD_API_TOKEN="replace_with_meta_system_user_token"
# WHATSAPP_OTP_TEMPLATE_NAME="karur_fresh_login_otp"
#
# Razorpay Payment Gateway (Server-Side Order Creation & HMAC Signature Verification):
# RAZORPAY_KEY_ID="rzp_test_replace_with_key"
# RAZORPAY_KEY_SECRET="replace_with_key_secret"
# RAZORPAY_WEBHOOK_SECRET="replace_with_webhook_secret"
#
# Future Optech Billing Sync (Deferred — NOT used now; stock comes from Manual Entry & Excel/CSV):
# OPTECH_SYNC_ENABLED="false"
# OPTECH_API_BASE_URL=""
# OPTECH_API_KEY=""
